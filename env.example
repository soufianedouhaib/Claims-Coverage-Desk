# Copy these into Vercel > Project > Settings > Environment Variables (never commit real values).
OPUS_SERVICE_KEY=
SESSION_SECRET=            # any random string, 32+ characters
REVIEW_WEBHOOK_SECRET=     # any random string; also pasted as a header in the workflow builder
ADMIN_EMAIL=
ADMIN_PASSWORD=            # only used for the very first sign-in
ADMIN_NAME=
# Optional
# WORKFLOW_ID=dfcf34a1-993e-4093-bd04-3022204c3f12
# PUBLIC_BASE_URL=https://your-app.vercel.app   (turns on the case-finished callback)
# REVIEW_WEBHOOK_HEADER=x-webhook-secret
# EVIDENCE_INPUT_TYPE=array_files
